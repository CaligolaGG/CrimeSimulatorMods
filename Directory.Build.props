<Project>
  <!--
    Shared settings for every mod under mods/.
    Machine-specific paths can be overridden in Directory.Build.user.props (git-ignored),
    see Directory.Build.user.props.example.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <!-- Your Thunderstore team name (namespace). Must match the team you upload with. -->
    <ThunderstoreTeam Condition="'$(ThunderstoreTeam)' == ''">caligola</ThunderstoreTeam>

    <!-- Where Crime Simulator is installed. -->
    <CsGameDir Condition="'$(CsGameDir)' == ''">Z:\SteamLibrary\steamapps\common\Crime Simulator</CsGameDir>
    <CsManagedDir>$(CsGameDir)\Crime Simulator_Data\Managed</CsManagedDir>

    <!-- Thunderstore Mod Manager / r2modman profile the build deploys into. -->
    <CsProfileDir Condition="'$(CsProfileDir)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\CrimeSimulator\profiles\Default</CsProfileDir>
    <!-- Set to false to only build, without copying into the profile. -->
    <DeployToProfile Condition="'$(DeployToProfile)' == ''">true</DeployToProfile>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Unity 2022.3 Mono supports .NET Standard 2.1 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <!-- Lets you access private/internal game members directly, as if they were public. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies: referenced from the local install, never copied to output. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(CsManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CsManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CsManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UI: uGUI, TextMeshPro, IMGUI (OnGUI windows) -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CsManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(CsManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(CsManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(CsManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(CsManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Photon Fusion: most gameplay classes derive from Fusion.NetworkBehaviour -->
    <Reference Include="Fusion.Runtime">
      <HintPath>$(CsManagedDir)\Fusion.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fusion.Common">
      <HintPath>$(CsManagedDir)\Fusion.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SensorToolkit: TriggerSensor/RaySensor used by interaction, truck storage, ... -->
    <Reference Include="Micosmo.SensorToolkit">
      <HintPath>$(CsManagedDir)\Micosmo.SensorToolkit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
